# Copie para .env e ajuste. Sem .env o projeto sobe com o provedor simulado.

# Chave da OpenUV (crie grátis em https://www.openuv.io). Vazia = provedor simulado.
OPENUV_API_KEY=
# Provedor do UV atual: openuv | simulado
UV_PROVIDER=openuv

# Intervalos de coleta (minutos). O plano grátis da OpenUV permite 50 chamadas/dia:
# 5 cidades x 1 chamada a cada 120 min entre 6h e 19h ≈ 35 chamadas/dia.
OPENUV_INTERVAL_MIN=120
OPENMETEO_INTERVAL_MIN=60
COLLECT_WINDOW_START_HOUR=6
COLLECT_WINDOW_END_HOUR=19

# Portas publicadas no host
DB_PORT=5432
API_PORT=8000
WEB_PORT=8080
